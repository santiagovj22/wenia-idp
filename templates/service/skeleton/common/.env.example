# Copy to .env and fill in values. .env is gitignored. Never commit secrets.

# Port the service listens on
PORT=3000

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# New Relic telemetry (AD-12). Leave empty to disable telemetry — the
# service still runs and logs "telemetry disabled".
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=${{ values.serviceName }}
