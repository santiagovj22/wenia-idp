# Copy to .env (the Ansible bootstrap does this for you) and fill in the values.
# .env is gitignored. Never paste these values into chats, issues or commits.

# Classic personal access token with scopes: repo, workflow, delete_repo
GITHUB_TOKEN=

# Set to "enabled" ONLY to demonstrate failure injection (story 3.3). Leave empty otherwise.
WENIA_FAILURE_INJECTION=
